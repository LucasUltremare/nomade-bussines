# ═══════════════════════════════════════════════════════════
# Nomade Business — configuração
# Copie pra .env e preencha. Linhas marcadas com * são obrigatórias.
# ═══════════════════════════════════════════════════════════

# ── Endereços ──────────────────────────────────────────────
# * Onde o público abre propostas e páginas de pagamento (serviço "server", porta 5002).
BASE_URL=https://pagamentos.suaempresa.com
# * Onde o time abre o painel (serviço "office", porta 5004).
PAINEL_URL=https://painel.suaempresa.com

# ── Acesso ─────────────────────────────────────────────────
# * Sócios: acesso total ao painel. Separados por vírgula.
ADMIN_EMAILS=ana@suaempresa.com,bruno@suaempresa.com
# Login com senha, sem Google Cloud (é o que o instalar.sh configura). Uma senha
# pra todos os e-mails de ADMIN_EMAILS. Deixe vazio pra usar só o Google.
ADMIN_SENHA=
# Idioma inicial do painel: en, pt ou es (dá pra trocar em Ajustes)
IDIOMA_PADRAO=
# * Segredo dos tokens de login. Gere com:  openssl rand -hex 32
JWT_SECRET=
# * Segredo entre o office e o server (prova que a request veio do proxy). openssl rand -hex 32
HQ_PROXY_SECRET=
# Login com Google — opcional se ADMIN_SENHA estiver preenchida (console.cloud.google.com → Credenciais → OAuth).
#   URI de redirecionamento autorizado: <PAINEL_URL>/hq/api/auth/google/callback
#   Origem JavaScript autorizada (login do CLI): <PAINEL_URL>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: callback do Google em outro endereço (padrão: <PAINEL_URL>/hq)
ADMIN_BASE_URL=

# ── Banco ──────────────────────────────────────────────────
# O docker-compose já sobe um Mongo. Usando um seu (Atlas etc.), aponte aqui.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB=nomade
MONGODB_OFFICE_DB=nomade_office
# Opcional: banco do escritório em outro cluster
AI_MONGODB_URI=

# ── Empresa (aparece pro cliente final) ────────────────────
EMPRESA_NOME=Sua Empresa
EMPRESA_EMAIL=contato@suaempresa.com
EMPRESA_SITE=https://suaempresa.com
# Só dígitos, com DDI e DDD
EMPRESA_WHATSAPP=
EMPRESA_CIDADE=
EMPRESA_SLOGAN=
# Uma ou duas frases do que a empresa faz. Entra nos prompts da IA
# (orquestrador, recepção do chat de leads, gerador de proposta).
EMPRESA_DESCRICAO=
# Nome na fatura do cartão (até 22 caracteres; padrão: EMPRESA_NOME)
EMPRESA_DESCRITOR=
EMPRESA_COR=#1026E9
LOGO_URL=
# Uma memória por empresa. No primeiro boot o banco do escritório é carimbado
# com um id desta empresa (aparece no log: Memória da empresa "..." (<id>)).
# Deixe vazio, a não ser pra renomear a empresa (cole aqui o id do log) ou
# pra fixar o id antes do primeiro boot.
EMPRESA_ID=

# ── Time ───────────────────────────────────────────────────
# Quem é quem no kanban, nas menções e na agenda dos sócios.
# Opção 1: copie config/time.example.json pra config/time.json e edite.
# Opção 2: o JSON inteiro aqui. Sem nenhum dos dois, cada ADMIN_EMAILS vira um membro.
TIME_JSON=
TIME_FILE=

# ── Pagamentos (Mercado Pago) ──────────────────────────────
# Webhook: <BASE_URL>/api/mp-webhook-payment
MP_ACCESS_TOKEN=

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Sua Empresa <contato@suaempresa.com>

# ── IA ─────────────────────────────────────────────────────
# Gemini: gerador de proposta, orçamento de lead e recepção do chat.
GEMINI_API_KEY=
# Anthropic: orquestrador do escritório.
ANTHROPIC_API_KEY=
# Alternativas e ajustes do orquestrador (opcionais)
OPENAI_API_KEY=
GLM_API_KEY=
ORQUESTRADOR_PROVIDER=
ORQUESTRADOR_MODEL=
EMBED_MODEL=
# Modelo local (Ollama). O da casa é o PatricJ: veja modelo/README.md.
# Sem OLLAMA_URL, título/tag automáticos, embeddings e decisões locais ficam desligados.
OLLAMA_URL=
OLLAMA_TEXT_MODEL=patricj
# Decisões (sistema 1): perguntas com resposta tipada e probabilidade
# (choice / score / predicate) em POST /api/office/decisoes.
# Com LLMGATEWAY_API_KEY usa o Jev (TypeSafe) pelo LLM Gateway; sem, usa o modelo local.
LLMGATEWAY_API_KEY=
JEV_MODEL=
LLMGATEWAY_URL=
# jev | local (vazio = o melhor disponível)
DECISOES_MOTOR=
# modelo local das decisões (padrão: OLLAMA_TEXT_MODEL)
DECISOES_MODELO=
# Escopos internos da memória, separados por vírgula (padrão: design, comercial, conteúdo, interno)
ESCOPOS_INTERNOS=
# Lembretes de relatório semanal por e-mail (a tela saiu do painel; 1 religa)
RELATORIO_SEMANAL=
# País (ISO, 2 letras), moeda (ISO 4217) e fuso de quem ainda não passou pelo
# onboarding. Depois disso vale o que estiver em Ajustes.
PAIS_PADRAO=
MOEDA_PADRAO=
FUSO_PADRAO=
# Worker de triagem em segundo plano
WORKER_DESLIGADO=
# Sincronização dos canais de atendimento (Mercado Livre, Shopee); 1 desliga
ATENDIMENTO_DESLIGADO=
WORKER_INTERVALO_MS=

# Em qual endereço os dois serviços escutam. Vazio = todos (o certo no Docker).
# 127.0.0.1 = só este computador abre (o lançador local, local/iniciar.mjs, usa).
BIND_HOST=
# 1 = instalação num computador, não num servidor (o lançador local liga).
# O painel passa a mostrar o passo "Este computador" no primeiro acesso.
NOMADE_LOCAL=

# ── Prospecção de leads (Google Places, opcional) ──────────
GOOGLE_PLACES_KEY=
GOOGLE_API_KEY=

# ── Google Drive Picker no kanban (opcional, build do painel) ──
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# ── Push no celular (opcional) ─────────────────────────────
# Gere uma vez:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── CORS: outros domínios que podem chamar a API do escritório pelo navegador ──
CORS_DOMINIOS=
